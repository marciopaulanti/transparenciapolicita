# ============================================================================
# Transparência Política — configuração de ambiente
# ---------------------------------------------------------------------------
# Copie para .env e ajuste. Todo campo tem um padrão que funciona em
# desenvolvimento; na VPS, o deploy.sh cria o .env sozinho.
# ============================================================================

# --- publicação -------------------------------------------------------------
# Onde o app está publicado.
#   "/"                              -> na raiz do domínio próprio
#   "/transparenciapolicita/"        -> em subdiretório de algum domínio
# Precisa concordar com o bloco do Caddy em deploy/Caddyfile.transparenciapolicita.
TP_BASE_PATH=/

# --- rede --------------------------------------------------------------------
TP_HOST=0.0.0.0
TP_PORT=8080

# --- dados -------------------------------------------------------------------
# Onde fica o arquivo do SQLite. Em produção, aponte para um volume.
TP_DATA_DIR=./data
TP_DB_PATH=./data/transparenciapolicita.sqlite
TP_SCHEMA=./db/schema.sql
TP_DATASET=./db/data/dataset.json

# --- comportamento -----------------------------------------------------------
# Uma linha por requisição servida, na tabela de auditoria.
TP_AUDITORIA=1

# Tamanho máximo do corpo aceito nas escritas, em bytes.
TP_MAX_BODY=32768

TZ=America/Sao_Paulo
