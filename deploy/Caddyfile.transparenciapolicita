# ============================================================================
# Caddy — Transparência Política (transparenciapolicita)
# ---------------------------------------------------------------------------
# Projeto independente: este bloco não tem relação com o gparla e não
# precisa ser combinado com o Caddyfile de nenhum outro projeto da VPS.
#
# Aponte um registro DNS A para o IP da VPS e cole o bloco abaixo no Caddy
# que quiser usar. O app responde em 127.0.0.1:8080 (porta publicada pelo
# docker-compose deste projeto), então não é preciso compartilhar rede
# Docker com o Caddy.
#
# Para publicar o app em um subdiretório em vez da raiz, troque
# TP_BASE_PATH=/ por TP_BASE_PATH=/transparenciapolicita/ no .env da VPS e
# use o bloco "SUBDIRETORIO" no lugar do bloco "SUBDOMINIO".
# ============================================================================


# ---------------------------------------------------------------- SUBDOMINIO
#
# transparenciapolicita.seudominio.com.br {
#     encode gzip zstd
#
#     # A API e o app são a mesma origem: nada de CORS.
#     reverse_proxy 127.0.0.1:8080
#
#     log {
#         output file /var/log/caddy/transparenciapolicita.log
#         format json
#     }
# }


# --------------------------------------------------------------- SUBDIRETORIO
#
# seudominio.com.br {
#     encode gzip zstd
#
#     # O app fica sob /transparenciapolicita. O prefixo é repassado intacto
#     # para o contêiner, que o usa para montar os endereços.
#     @transparenciapolicita path /transparenciapolicita /transparenciapolicita/*
#     handle @transparenciapolicita {
#         reverse_proxy 127.0.0.1:8080
#     }
#
#     log {
#         output file /var/log/caddy/transparenciapolicita.log
#         format json
#     }
# }
